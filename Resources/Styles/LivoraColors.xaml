<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- LIVORA design tokens — design system v2 (Wave 3, lane 05).
         Calm, premium, human — not the default .NET purple.

         KEY STABILITY RULE (lanes 01-09 build against these names): existing key NAMES and their
         roles never change. v2 only (a) adds the tokens §2 of LANES.md lists, (b) tunes VALUES
         so both themes hit WCAG AA for text, (c) keeps every metric hue brand-stable.

         Contrast notes (computed, sRGB relative luminance):
         light  — TextSecondary 5.8:1 .. 4.9:1 across all light surfaces,
                  TextTertiary 4.8:1 .. 4.1:1, Caution darkened so white-on-fill passes 4.5+,
                  Accent on white 4.9:1, AccentText(AccentDeep) 6.4-7.5:1.
         dark   — TextSecondaryDark 6.5:1 on Surface, TextTertiaryDark 5.9:1 on Surface,
                  AccentDark/PositiveDark 6.8:1+ everywhere, CautionDark 8.8:1, NegativeDark 6.4:1.
         Metric hues are theme-stable for rails/bars (decorative, AA-exempt); the *Dark mirrors
         let lanes pair them in AppThemeBindings for text on dark surfaces (all >= 6.3:1). -->

    <!-- Brand -->
    <Color x:Key="Accent">#3E7C6F</Color>
    <Color x:Key="AccentSoft">#E4F0ED</Color>
    <Color x:Key="AccentDeep">#2C5D53</Color>
    <!-- AA-safe accent TEXT per theme (use instead of Accent for small accent-colored text). -->
    <Color x:Key="AccentText">#2C5D53</Color>
    <Color x:Key="AccentTextDark">#7CBBA9</Color>

    <!-- Surfaces (light theme) -->
    <Color x:Key="BgPrimary">#F7F6F3</Color>
    <Color x:Key="Surface">#FFFFFF</Color>
    <Color x:Key="SurfaceAlt">#F0EFEB</Color>
    <Color x:Key="Overlay">#E7E5E0</Color>

    <!-- Text -->
    <Color x:Key="TextPrimary">#1C1B1A</Color>
    <Color x:Key="TextSecondary">#67655F</Color>
    <Color x:Key="TextTertiary">#75726B</Color>
    <Color x:Key="TextOnAccent">#FFFFFF</Color>

    <!-- Semantic metric colors -->
    <Color x:Key="MetricSleep">#5B6FA8</Color>
    <Color x:Key="MetricSleepSoft">#E8EBF5</Color>
    <Color x:Key="MetricActivity">#C97B3D</Color>
    <Color x:Key="MetricActivitySoft">#F7EDE3</Color>
    <Color x:Key="MetricRecovery">#3E7C6F</Color>
    <Color x:Key="MetricRecoverySoft">#E4F0ED</Color>
    <Color x:Key="MetricWellness">#8A6FA8</Color>
    <Color x:Key="MetricWellnessSoft">#EFEAF6</Color>
    <Color x:Key="Positive">#3E7C6F</Color>
    <Color x:Key="Caution">#8F6410</Color>
    <Color x:Key="Negative">#B65C4B</Color>
    <!-- Soft tints for semantic chips (v2) + AA text tones to pair on them. -->
    <Color x:Key="PositiveSoft">#E4F0ED</Color>
    <Color x:Key="CautionSoft">#F6EAD2</Color>
    <Color x:Key="NegativeSoft">#F5E2DD</Color>
    <Color x:Key="CautionText">#8A5F0D</Color>
    <Color x:Key="NegativeText">#8F3B2C</Color>

    <!-- Dark theme mirrors -->
    <Color x:Key="BgPrimaryDark">#141412</Color>
    <Color x:Key="SurfaceDark">#1F1E1C</Color>
    <Color x:Key="SurfaceAltDark">#282724</Color>
    <Color x:Key="OverlayDark">#3A3936</Color>
    <Color x:Key="TextPrimaryDark">#ECEAE6</Color>
    <Color x:Key="TextSecondaryDark">#A5A29B</Color>
    <Color x:Key="TextTertiaryDark">#9D9990</Color>
    <Color x:Key="AccentSoftDark">#243832</Color>
    <Color x:Key="MetricSleepSoftDark">#262C3E</Color>
    <Color x:Key="MetricActivitySoftDark">#3A2D20</Color>
    <Color x:Key="MetricRecoverySoftDark">#243832</Color>
    <Color x:Key="MetricWellnessSoftDark">#2E2738</Color>
    <Color x:Key="PositiveSoftDark">#243832</Color>
    <Color x:Key="CautionSoftDark">#3A2F1B</Color>
    <Color x:Key="NegativeSoftDark">#3B2723</Color>
    <!-- v2: AA text/icon mirrors of the semantic + metric hues for dark surfaces. -->
    <Color x:Key="AccentDark">#7CBBA9</Color>
    <Color x:Key="PositiveDark">#7CBBA9</Color>
    <Color x:Key="CautionDark">#E9B44E</Color>
    <Color x:Key="NegativeDark">#E58773</Color>
    <Color x:Key="MetricSleepDark">#93A9E4</Color>
    <Color x:Key="MetricActivityDark">#E79C5F</Color>
    <Color x:Key="MetricRecoveryDark">#7CBBA9</Color>
    <Color x:Key="MetricWellnessDark">#B49BDB</Color>

    <!-- Focus / keyboard navigation ring (themed pair). -->
    <Color x:Key="FocusRing">#3E7C6F</Color>
    <Color x:Key="FocusRingDark">#7CBBA9</Color>

    <!--
        RULE: a *Brush key is a SolidColorBrush and may ONLY be used on brush-typed
        properties (Border.Background, Border.Stroke, Shape.Fill/Stroke). Color-typed
        properties (Label.TextColor, Button.TextColor/BorderColor, Entry.TextColor/
        PlaceholderColor, BoxView.Color, ProgressBar.ProgressColor, Shell.*Color) must use
        a Color — either a plain {StaticResource <Key>} for theme-stable colors, or an
        inline {AppThemeBinding Light=..., Dark=...} for themed ones.
        Assigning a SolidColorBrush to a Color property makes BindableObject log
        "Cannot convert SolidColorBrush to type 'Color'" and leaves the property null,
        which is what crashed the app at render time.
    -->

    <!-- Themed brushes (brush-typed targets only). Color-typed properties use inline
         {AppThemeBinding Light=..., Dark=...} against the plain Color keys above. -->
    <SolidColorBrush x:Key="BgPrimaryBrush" Color="{AppThemeBinding Light={StaticResource BgPrimary}, Dark={StaticResource BgPrimaryDark}}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}"/>
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="{AppThemeBinding Light={StaticResource SurfaceAlt}, Dark={StaticResource SurfaceAltDark}}"/>
    <SolidColorBrush x:Key="OverlayBrush" Color="{AppThemeBinding Light={StaticResource Overlay}, Dark={StaticResource OverlayDark}}"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{AppThemeBinding Light={StaticResource AccentSoft}, Dark={StaticResource AccentSoftDark}}"/>
    <SolidColorBrush x:Key="MetricSleepSoftBrush" Color="{AppThemeBinding Light={StaticResource MetricSleepSoft}, Dark={StaticResource MetricSleepSoftDark}}"/>
    <SolidColorBrush x:Key="MetricActivitySoftBrush" Color="{AppThemeBinding Light={StaticResource MetricActivitySoft}, Dark={StaticResource MetricActivitySoftDark}}"/>
    <SolidColorBrush x:Key="MetricRecoverySoftBrush" Color="{AppThemeBinding Light={StaticResource MetricRecoverySoft}, Dark={StaticResource MetricRecoverySoftDark}}"/>
    <SolidColorBrush x:Key="MetricWellnessSoftBrush" Color="{AppThemeBinding Light={StaticResource MetricWellnessSoft}, Dark={StaticResource MetricWellnessSoftDark}}"/>
    <SolidColorBrush x:Key="PositiveSoftBrush" Color="{AppThemeBinding Light={StaticResource PositiveSoft}, Dark={StaticResource PositiveSoftDark}}"/>
    <SolidColorBrush x:Key="CautionSoftBrush" Color="{AppThemeBinding Light={StaticResource CautionSoft}, Dark={StaticResource CautionSoftDark}}"/>
    <SolidColorBrush x:Key="NegativeSoftBrush" Color="{AppThemeBinding Light={StaticResource NegativeSoft}, Dark={StaticResource NegativeSoftDark}}"/>

    <!-- v2 text/semantic brushes for Border-typed targets (chip strokes, tinted rails). -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"/>
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="{AppThemeBinding Light={StaticResource TextTertiary}, Dark={StaticResource TextTertiaryDark}}"/>
    <SolidColorBrush x:Key="AccentTextBrush" Color="{AppThemeBinding Light={StaticResource AccentText}, Dark={StaticResource AccentTextDark}}"/>
    <SolidColorBrush x:Key="PositiveTextBrush" Color="{AppThemeBinding Light={StaticResource AccentText}, Dark={StaticResource PositiveDark}}"/>
    <SolidColorBrush x:Key="CautionTextBrush" Color="{AppThemeBinding Light={StaticResource CautionText}, Dark={StaticResource CautionDark}}"/>
    <SolidColorBrush x:Key="NegativeTextBrush" Color="{AppThemeBinding Light={StaticResource NegativeText}, Dark={StaticResource NegativeDark}}"/>
    <SolidColorBrush x:Key="FocusRingBrush" Color="{AppThemeBinding Light={StaticResource FocusRing}, Dark={StaticResource FocusRingDark}}"/>

    <!-- Theme-stable brushes. The semantic fills stay theme-stable ON PURPOSE: existing pages
         (TodayPage ChipCaution) paint white label text on them, which only the deep light value
         passes; their themed text pairs live in the *TextBrush keys above. -->
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Accent}"/>
    <SolidColorBrush x:Key="MetricSleepBrush" Color="{StaticResource MetricSleep}"/>
    <SolidColorBrush x:Key="MetricActivityBrush" Color="{StaticResource MetricActivity}"/>
    <SolidColorBrush x:Key="MetricRecoveryBrush" Color="{StaticResource MetricRecovery}"/>
    <SolidColorBrush x:Key="MetricWellnessBrush" Color="{StaticResource MetricWellness}"/>
    <SolidColorBrush x:Key="CautionBrush" Color="{StaticResource Caution}"/>
    <SolidColorBrush x:Key="NegativeBrush" Color="{StaticResource Negative}"/>
    <SolidColorBrush x:Key="PositiveBrush" Color="{StaticResource Positive}"/>

    <!-- Card elevation (v2). Soft, warm-black; reads on light surfaces, stays invisible-safe on dark. -->
    <Shadow x:Key="CardShadow" Offset="0,10" Radius="24" Opacity="0.10" Brush="#0A0A0A"/>
    <Shadow x:Key="FloatShadow" Offset="0,4" Radius="12" Opacity="0.14" Brush="#0A0A0A"/>

    <!-- Geometry -->
    <x:Double x:Key="CardRadius">20</x:Double>
    <x:Double x:Key="ChipRadius">14</x:Double>
    <x:Double x:Key="PagePadding">20</x:Double>
    <x:Double x:Key="CardSpacing">14</x:Double>
    <x:Double x:Key="SegmentRadius">14</x:Double>
    <x:Double x:Key="ControlHeight">44</x:Double>
    <x:Double x:Key="ButtonHeight">50</x:Double>
    <x:Double x:Key="IconSize">22</x:Double>
    <x:Double x:Key="Hairline">1</x:Double>
    <CornerRadius x:Key="CardCornerRadius">20</CornerRadius>
    <CornerRadius x:Key="ChipCornerRadius">14</CornerRadius>
    <CornerRadius x:Key="SegmentCornerRadius">14</CornerRadius>
    <CornerRadius x:Key="ControlCornerRadius">16</CornerRadius>
    <Thickness x:Key="CardPadding">18</Thickness>
    <Thickness x:Key="PageThickness">20,12</Thickness>
    <Thickness x:Key="FieldLabelMargin">2,0,2,4</Thickness>

    <x:Boolean x:Key="IsNotStringEmptyKey">True</x:Boolean>
</ResourceDictionary>
