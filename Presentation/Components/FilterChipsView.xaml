<?xml version="1.0" encoding="UTF-8" ?>
<ContentView
    x:Class="LIVORA.Presentation.Components.FilterChipsView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:comp="clr-namespace:LIVORA.Presentation.Components"
    x:DataType="comp:FilterChipsView">

    <!-- Shared filter-chip row (lane 09; lanes 07/08 code against this name). Wrapping
         FlexLayout so a long Persian chip label never clips; every chip is a ≥44dp touch
         target (the app-wide mobile floor); Start/End alignment keeps RTL mirroring intact.
         Labels arrive already localized via
         ItemsSource — the component stores no strings and does no formatting.
         Brush tokens (Border.Background / Border.Stroke) only, per the design-token rule. -->
    <FlexLayout
        x:Name="ChipRow"
        BindableLayout.ItemsSource="{Binding ItemsSource}"
        Wrap="Wrap"
        Direction="Row"
        AlignItems="Center"
        JustifyContent="Start">
        <BindableLayout.ItemTemplate>
            <DataTemplate x:DataType="comp:FilterChipItem">
                <Border
                    Padding="14,8"
                    Margin="0,0,8,8"
                    MinimumHeightRequest="44"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 14"
                    Background="{StaticResource SurfaceBrush}"
                    Stroke="{StaticResource OverlayBrush}"
                    comp:TappableFeedback.Tappable="True"
                    SemanticProperties.Description="{Binding Label}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnChipTapped" CommandParameter="{Binding .}" />
                    </Border.GestureRecognizers>
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                            <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                            <Setter Property="Stroke" Value="{StaticResource AccentBrush}" />
                        </DataTrigger>
                    </Border.Triggers>
                    <Label
                        Text="{Binding Label}"
                        Style="{StaticResource LCaption}"
                        FontSize="13"
                        FontAttributes="Bold"
                        VerticalTextAlignment="Center"
                        HorizontalTextAlignment="Center"
                        LineBreakMode="WordWrap"
                        MaxLines="2">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="TextColor" Value="{StaticResource Accent}" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </Border>
            </DataTemplate>
        </BindableLayout.ItemTemplate>
    </FlexLayout>
</ContentView>
