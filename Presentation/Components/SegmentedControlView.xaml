<?xml version="1.0" encoding="utf-8"?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LIVORA.Presentation.Components.SegmentedControlView">

    <!-- SegmentedControlView (lane 05): single-select pill rail — the shared control behind
         theme mode (lane 06), the language switcher, and filter rows (lanes 01/03/09).

         Structure only in XAML: segment cells are built in code-behind because their count and
         labels are data-driven, must rebuild on ItemsSource/language change, and repaint on
         selection without owning any binding the host page might want.

         Equal-width columns (not a HorizontalStackLayout) so two short segments still fill a
         320dp card the way a premium segmented control should; the grid mirrors under
         FlowDirection RightToLeft, and the selected segment is marked by FILL (no directional
         slide), so EN and fa read identically — Start/End semantics only (§0.6). -->
    <Border x:Name="Track"
            StrokeShape="RoundRectangle 16"
            StrokeThickness="1"
            Padding="3"
            MinimumHeightRequest="44"
            Background="{StaticResource SurfaceAltBrush}"
            Stroke="{StaticResource OverlayBrush}">
        <Grid x:Name="Segments" ColumnSpacing="3"/>
    </Border>
</ContentView>
