<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<IsPackable>false</IsPackable>
		<ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
		<!-- The MAUI app project is excluded by wildcard below; we compile the pure layers in. -->
		<EnableDefaultCompileItems>false</EnableDefaultCompileItems>
	</PropertyGroup>

	<ItemGroup>
		<!-- Pure, framework-agnostic source under test (Domain + Application layers). -->
		<Compile Include="$(MSBuildThisFileDirectory)..\Domain\**\*.cs" LinkBase="Domain" />
		<Compile Include="$(MSBuildThisFileDirectory)..\Application\**\*.cs" LinkBase="Application" />
		<!-- One UI-free Infrastructure file is under test too: the deterministic mock intelligence
		     provider (insight topic selection) depends only on Domain + Application abstractions. -->
		<Compile Include="$(MSBuildThisFileDirectory)..\Infrastructure\IntelligenceProviders\SampleIntelligenceProvider.cs" LinkBase="Infrastructure" />
		<Compile Include="$(MSBuildThisFileDirectory)Tests\**\*.cs" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
		<PackageReference Include="xunit" Version="2.9.2" />
		<PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
	</ItemGroup>

</Project>
