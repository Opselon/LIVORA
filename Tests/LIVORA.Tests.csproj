<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<IsPackable>false</IsPackable>
		<ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
		<!-- The MAUI app project is excluded by wildcard below; we compile the pure layers in. -->
		<EnableDefaultCompileItems>false</EnableDefaultCompileItems>
	</PropertyGroup>

	<ItemGroup>
		<!-- Pure, framework-agnostic source under test (Domain + Application layers). -->
		<Compile Include="$(MSBuildThisFileDirectory)..\Domain\**\*.cs" LinkBase="Domain" />
		<Compile Include="$(MSBuildThisFileDirectory)..\Application\**\*.cs" LinkBase="Application" />
		<!-- One UI-free Infrastructure file is under test too: the deterministic mock intelligence
		     provider (insight topic selection) depends only on Domain + Application abstractions. -->
		<Compile Include="$(MSBuildThisFileDirectory)..\Infrastructure\IntelligenceProviders\SampleIntelligenceProvider.cs" LinkBase="Infrastructure" />
		<!-- WAVE 3 (lane 10): the localization stack is MAUI-free even though it lives under
		     Infrastructure/ — LocalizationService needs only Application.Abstractions +
		     Microsoft.Extensions.Logging.Abstractions, so the real key lookup, the [missing]
		     fallback and the Persian digit / percent / duration formatting are all testable here.
		     AppResources.cs + the two resx files give the test assembly its own resource manifest,
		     which is what the resx-integrity and honesty suites read.
		     DemoDataSeeder is likewise MAUI/IO-free (it talks to IRepository + a Func<string,string>
		     localizer), so its seeding/idempotency logic is compiled in for real coverage. -->
		<Compile Include="$(MSBuildThisFileDirectory)..\Resources\Localization\AppResources.cs" LinkBase="Resources" />
		<Compile Include="$(MSBuildThisFileDirectory)..\Infrastructure\Localization\*.cs" LinkBase="Infrastructure" />
		<Compile Include="$(MSBuildThisFileDirectory)..\Infrastructure\Persistence\DemoDataSeeder.cs" LinkBase="Infrastructure" />
		<!-- WAVE3B lane02: Health Connect foundation is MAUI-free (Android code behind #if ANDROID). -->
		<Compile Include="$(MSBuildThisFileDirectory)..\Infrastructure\HealthProviders\HealthConnectProvider.cs" LinkBase="Infrastructure" />
		<Compile Include="$(MSBuildThisFileDirectory)..\Infrastructure\HealthProviders\HealthConnectAndroidBridge.cs" LinkBase="Infrastructure" />
		<!-- WAVE3C lanes 01/02/06: security stack, real AI orchestration, durable storage (MAUI-free; crypt32 behind #if WINDOWS). Merged once, deduped. -->
		<Compile Include="$(MSBuildThisFileDirectory)..\Infrastructure\Security\IPlatformSecureBox.cs" LinkBase="Infrastructure" />
		<Compile Include="$(MSBuildThisFileDirectory)..\Infrastructure\Security\SecureStorageService.cs" LinkBase="Infrastructure" />
		<Compile Include="$(MSBuildThisFileDirectory)..\Infrastructure\Security\ConsentStore.cs" LinkBase="Infrastructure" />
		<Compile Include="$(MSBuildThisFileDirectory)..\Infrastructure\Security\CloudAuthService.cs" LinkBase="Infrastructure" />
		<Compile Include="$(MSBuildThisFileDirectory)..\Infrastructure\Security\LocalPasscodeService.cs" LinkBase="Infrastructure" />
		<Compile Include="$(MSBuildThisFileDirectory)..\Infrastructure\Security\NoopSyncTransport.cs" LinkBase="Infrastructure" />
		<Compile Include="$(MSBuildThisFileDirectory)..\Infrastructure\Security\Gateway\GatewayKeyStore.cs" LinkBase="Infrastructure" />
		<Compile Include="$(MSBuildThisFileDirectory)..\Infrastructure\Security\Gateway\GatewayConfigService.cs" LinkBase="Infrastructure" />
		<Compile Include="$(MSBuildThisFileDirectory)..\Infrastructure\Persistence\LocalJsonStore.cs" LinkBase="Infrastructure" />
		<Compile Include="$(MSBuildThisFileDirectory)..\Infrastructure\Persistence\LocalDataCatalog.cs" LinkBase="Infrastructure" />
		<Compile Include="$(MSBuildThisFileDirectory)..\Infrastructure\IntelligenceProviders\Wave3c\*.cs" LinkBase="Infrastructure" />
		<Compile Include="$(MSBuildThisFileDirectory)..\Infrastructure\Persistence\Wave3b\*.cs" LinkBase="Infrastructure" />
		<!-- WAVE4 P1-D: the client<->cloud seam is MAUI-free by contract (HttpClient +
		     Microsoft.Extensions.* only), so it compiles and unit-tests in this plain-net10.0
		     project. Pre-wired as a wildcard by the lead so the lane never edits this file. -->
		<Compile Include="$(MSBuildThisFileDirectory)..\Infrastructure\Cloud\*.cs" LinkBase="Infrastructure" />
		<!-- WAVE3C: lane suites live under Tests/Wave3c/<area>/ (outside the legacy Tests/Tests glob). -->
		<Compile Include="$(MSBuildThisFileDirectory)Wave3c\**\*.cs" LinkBase="Wave3c" />
		<EmbeddedResource Include="$(MSBuildThisFileDirectory)..\Resources\Localization\AppResources.resx">
			<ManifestResourceName>LIVORA.Resources.Localization.AppResources</ManifestResourceName>
		</EmbeddedResource>
		<EmbeddedResource Include="$(MSBuildThisFileDirectory)..\Resources\Localization\AppResources.fa.resx">
			<ManifestResourceName>LIVORA.Resources.Localization.AppResources.fa</ManifestResourceName>
		</EmbeddedResource>
		<Compile Include="$(MSBuildThisFileDirectory)Tests\**\*.cs" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
		<PackageReference Include="xunit" Version="2.9.2" />
		<PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
		<!-- Only the abstractions are needed: LocalizationService takes ILogger<T>, and the DI
		     smoke test builds a real ServiceProvider so Wave 3 registrations are verified for real. -->
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
	</ItemGroup>

</Project>
