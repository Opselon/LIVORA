// PLANTED TRIPWIRE VIOLATION (P1-F proof-of-fire). Product law §0.5 / §7: no raw token or health
// VALUE in a log call. Four leak shapes planted: a structured argument carrying the refresh token,
// an interpolated hole carrying the access token, a member access carrying a password, and a raw
// health value argument. Correlation ids and counts elsewhere in the same file are fine — the rule
// is about VALUES, and this file exists so the rule proves it can tell. .fix = not compiled.
namespace Livora.QualityFixtures;

public sealed class LooseLips
{
    public void OnReuse(string correlationId, string refreshToken, string accessToken,
        Account account, HealthRow row)
    {
        logger.LogWarning("refresh token reused for session", refreshToken);
        logger.LogInformation($"login minted {accessToken} for {correlationId}");
        logger.LogError($"auth failed: {account.Password}");
        logger.LogInformation("raw sleep value {value}", row.SleepMinutesRaw);
    }
}
