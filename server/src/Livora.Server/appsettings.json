{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "sqlite",
    "ApplyMigrationsOnStart": "false"
  },
  "ConnectionStrings": {
    "Livora": "Data Source=livora.db"
  },
  "Identity": {
    "AccessTokenLifetimeMinutes": 15,
    "RefreshTokenLifetimeDays": 30,
    "Google": {
      "ClientId": "",
      "ClientSecret": ""
    }
  },
  "Ai": {
    "BaseUrl": "",
    "ApiKey": "",
    "Model": "",
    "Enabled": false
  },
  "Payments": {
    "Provider": "unconfigured",
    "ApiKey": "",
    "WebhookSigningSecret": ""
  },
  "Sync": {
    "MaxOperationsPerBatch": 200,
    "MaxPayloadBytes": 60000
  }
}
