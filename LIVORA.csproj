<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0-android</TargetFrameworks>
		<TargetFrameworks Condition="!$([MSBuild]::IsOSPlatform('linux'))">$(TargetFrameworks);net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>

		<OutputType>Exe</OutputType>
		<RootNamespace>LIVORA</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- XAML source generation for faster builds and runtime performance. -->
		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<ApplicationTitle>LIVORA</ApplicationTitle>
		<ApplicationId>com.livora.app</ApplicationId>
		<ApplicationDisplayVersion>1.1</ApplicationDisplayVersion>
		<ApplicationVersion>2</ApplicationVersion>

		<!-- Unpackaged Windows dev build (Store packaging is a Wave 3 task). -->
		<WindowsPackageType>None</WindowsPackageType>

		<!-- Isolate from the parent repos Directory.Packages.props (pins old 9.x previews). -->
		<ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>

		<!-- Universal Android APK for CI: pass -p:AndroidUniversalRid=true
		     (a bare ';'-containing RID list on the command line is split by PowerShell 5.1). -->
		<RuntimeIdentifiers Condition="$(TargetFramework.StartsWith('net10.0-android')) and '$(AndroidUniversalRid)' == 'true'">android-arm64;android-x64;android-x86</RuntimeIdentifiers>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
	</PropertyGroup>

	<ItemGroup>
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#2C5D53" />
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#2C5D53" BaseSize="128,128" />
		<MauiImage Include="Resources\Icons\*" />
		<MauiFont Include="Resources\Fonts\*" />
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
		<MauiXaml Update="Resources\Styles\LivoraColors.xaml" />
		<MauiXaml Update="Resources\Styles\LivoraStyles.xaml" />
	</ItemGroup>

	<!-- Test sources never ship in the app. -->
	<ItemGroup>
		<Compile Remove="Tests\**\*.cs" />
		<MauiXaml Remove="Tests\**\*.xaml" />
		<EmbeddedResource Remove="Tests\**" />
		<None Remove="Tests\**\*" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
		<!-- Wave 3: local reminders + charts. Both ship net10.0-android/-ios/-maccatalyst/
		     -windows10.0.19041 assets, so they are safe on all four heads. -->
		<PackageReference Include="Plugin.LocalNotification" Version="14.1.2" />
		<PackageReference Include="SkiaSharp" Version="4.152.0" />
		<PackageReference Include="SkiaSharp.Views.Maui.Controls" Version="4.152.0" />
	</ItemGroup>

</Project>
