<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:LIVORA"
             xmlns:comp="clr-namespace:LIVORA.Presentation.Components"
             xmlns:resp="clr-namespace:LIVORA.Presentation.Responsive"
             x:Class="LIVORA.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary>
                <comp:IsNotEmptyConverter x:Key="IsNotEmpty" />
                <comp:ColorByKeyConverter x:Key="ColorByKey" />
                <!-- Responsive glue (lane 04): pages key IsVisible / ColumnSpan off the live
                     AdaptiveLayout.Breakpoint attached value through these. -->
                <resp:BreakpointToBoolConverter x:Key="BpToBool" />
                <resp:BreakpointToIntConverter x:Key="BpToInt" />
            </ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/LivoraColors.xaml" />
                <ResourceDictionary Source="Resources/Styles/LivoraStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
